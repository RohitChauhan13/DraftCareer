generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String   @default("user")
  emailVerified Boolean  @default(false) @map("email_verified")
  isBlocked     Boolean  @default(false) @map("is_blocked")
  aiEnhanceCount Int     @default(0) @map("ai_enhance_count")
  aiEnhanceDailyCount Int @default(0) @map("ai_enhance_daily_count")
  aiEnhanceDailyDate String? @map("ai_enhance_daily_date")
  aiEnhanceBlocked Boolean @default(false) @map("ai_enhance_blocked")
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  resumes       Resume[]

  @@map("users")
}

model OtpVerification {
  id           String   @id @default(cuid())
  email        String
  otpHash      String   @map("otp_hash")
  purpose      String   @default("email_verification")
  attempts     Int      @default(0)
  resendCount  Int      @default(0) @map("resend_count")
  expiresAt    DateTime @map("expires_at")
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("otp_verifications")
}

model Resume {
  id         String          @id @default(cuid())
  userId     String          @map("user_id")
  title      String
  templateId String          @default("modern") @map("template_id")
  isPinned   Boolean         @default(false) @map("is_pinned")
  isPublic   Boolean         @default(false) @map("is_public")
  shareSlug  String?         @unique @map("share_slug")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections   ResumeSection[]

  @@index([userId])
  @@index([userId, isPinned, updatedAt])
  @@map("resumes")
}

model ResumeSection {
  id          String   @id @default(cuid())
  resumeId    String   @map("resume_id")
  sectionType String   @map("section_type")
  contentJson Json     @map("content_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, sectionType])
  @@map("resume_sections")
}

model DonationSettings {
  id            String   @id @default("main")
  isPageVisible Boolean  @default(true) @map("is_page_visible")
  upiId         String   @default("example@ybl") @map("upi_id")
  isQrVisible   Boolean  @default(true) @map("is_qr_visible")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("donation_settings")
}

model TemplateTagSetting {
  templateId String   @id @map("template_id")
  tag        String?
  isVisible  Boolean  @default(true) @map("is_visible")
  sortOrder  Int      @default(0) @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("template_tag_settings")
}

model AiEnhanceSettings {
  id              String   @id @default("main")
  limitPerUser    Int      @default(3) @map("limit_per_user")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ai_enhance_settings")
}
